package ui

import (
	"fmt"
	"strconv"

	"github.com/sntsoftgit/pqcaton/pkg/inventory/scope"
)

// scopePage — 자산 스코프. **exclude 추가만 근거 필수**라, 그 무게 차이가 화면에 보여야 한다.
templ scopePage(v ScopeView) {
	@shell(v.Page) {
		@scopeForm(v)
	}
}

// scopeForm — 스코프를 승인하는 폼. **껍데기와 갈라 둔다** — 요약을 얹은 새 화면이
// 같은 폼을 그대로 쓴다. 확정 경로가 두 벌이 되면 한쪽이 어긋나는 날이 온다.
templ scopeForm(v ScopeView) {
	@tip(v.Page.Lang, tScopeIntro.In(v.Page.Lang)+" "+tScopeDelta.In(v.Page.Lang)+" "+tScopeConclusionHint.In(v.Page.Lang))
	<form method="post" action="/scope/finalize">
		if len(v.Editing) > 0 {
			@ruleLegend(v.Page.Lang)
			for _, e := range v.Editing {
				@layerEditor(v.Page.Lang, e)
			}
			<div class="actions">
				<button formaction="/scope/rules" class="primary">{ tSaveRules.In(v.Page.Lang) }</button>
				@tip(v.Page.Lang, tSaveRulesHint.In(v.Page.Lang))
			</div>
			<h2>{ tScopeEditResult.In(v.Page.Lang) }</h2>
		}
		for _, g := range v.Layers {
			<fieldset>
				<legend>
					{ layerName(v.Page.Lang, g.Name) }
					<span class="n">
						— { strconv.Itoa(len(g.Changes)) } { tChanges.In(v.Page.Lang) }
						if g.Audited > 0 {
							, { strconv.Itoa(g.Audited) } { tReasonNeeded.In(v.Page.Lang) }
						}
					</span>
				</legend>
				<label>
					{ tLayerConclusion.In(v.Page.Lang) }
					<input
						type="text"
						name={ "layer:" + g.Name }
						value={ g.Conclusion }
						placeholder={ tLayerPlaceholder.In(v.Page.Lang) }
					/>
				</label>
				<table>
					<tr>
						<th style="width:4rem">{ tColChange.In(v.Page.Lang) }</th>
						<th>{ tColRule.In(v.Page.Lang) }</th>
						<th>{ tColNote.In(v.Page.Lang) }</th>
						<th>{ tColException.In(v.Page.Lang) }</th>
					</tr>
					for _, c := range g.Changes {
						<tr>
							<td class={ templ.KV("must", c.Audited) }>{ kindLabel(v.Page.Lang, c.Kind) }</td>
							<td><code>{ c.Rule }</code></td>
							<td class="hint">{ c.Note }</td>
							<td><input type="text" name={ "change:" + c.ID } value={ c.Conclusion }/></td>
						</tr>
					}
				</table>
			</fieldset>
		}
		if len(v.Layers) == 0 {
			<p>{ tScopeEmpty.In(v.Page.Lang) }</p>
		}
		<fieldset>
			<legend>{ tApproval.In(v.Page.Lang) }</legend>
			@tip(v.Page.Lang, tScopeApprovalHint.In(v.Page.Lang))
			<label>
				{ tReviewer.In(v.Page.Lang) }
				<input type="text" name="reviewer" value={ v.Session.Reviewer }/>
			</label>
			<label style="display:block;margin-top:.6rem">
				{ tSignature.In(v.Page.Lang) }
				<input type="text" name="signature" value={ v.Session.Signature }/>
			</label>
		</fieldset>
		<fieldset>
			<legend>
				{ tPolicyOnFinalize.In(v.Page.Lang) }
				<span class="n">— { fmt.Sprintf(tPolicyRulesAll.In(v.Page.Lang), len(v.Session.Merged)) }</span>
			</legend>
			@tip(v.Page.Lang, tPolicyWholeHint.In(v.Page.Lang))
			<table>
				<tr>
					<th style="width:6rem">action</th><th style="width:6rem">runtime</th>
					<th>lib</th><th>app_key</th><th>note</th>
				</tr>
				for _, r := range v.Session.Merged {
					<tr>
						<td class={ templ.KV("must", r.Action == "exclude") }>{ r.Action }</td>
						<td>{ r.Runtime }</td>
						<td><code>{ r.Lib }</code></td>
						<td><code>{ r.AppKey }</code></td>
						<td class="hint">{ r.Note }</td>
					</tr>
				}
			</table>
		</fieldset>
		<div class="actions">
			<button formaction="/scope/save">{ tSaveOnly.In(v.Page.Lang) }</button>
			<button formaction="/scope/finalize" class="primary">{ tFinalizePolicy.In(v.Page.Lang) }</button>
			@tip(v.Page.Lang, tScopeGateHint.In(v.Page.Lang))
		</div>
	</form>
}

// ruleLegend — 다섯 칸이 무슨 뜻인지. **여기 두는 것이 문서로 미루는 것보다 싸다** —
// 규칙을 적는 자리에서 읽히고, 화면이 바뀌면 같이 바뀐다.
templ ruleLegend(l Lang) {
	@tipBlock(tRuleLegend.In(l)) {
		<table>
			<tr><th style="width:7rem">{ tColMeaning.In(l) }</th><th>{ tColMeans.In(l) }</th></tr>
			<tr><td><code>action</code></td><td>@templ.Raw(tRuleAction.In(l))</td></tr>
			<tr><td><code>runtime</code></td><td>@templ.Raw(tRuleRuntime.In(l))</td></tr>
			<tr><td><code>lib</code></td><td>@templ.Raw(tRuleLib.In(l))</td></tr>
			<tr><td><code>app_key</code></td><td>@templ.Raw(tRuleAppKey.In(l))</td></tr>
			<tr><td><code>note</code></td><td>@templ.Raw(tRuleNote.In(l))</td></tr>
		</table>
		<p class="hint">@templ.Raw(tRuleEmptyWarn.In(l))</p>
		<p class="hint">@templ.Raw(tRuleLayerOrder.In(l))</p>
		<p class="hint">@templ.Raw(tScopeTableOrder.In(l))</p>
		<p class="hint">@templ.Raw(tRemoveRuleHint.In(l))</p>
	}
}

// layerEditor — 계층 하나의 규칙 표.
templ layerEditor(l Lang, e LayerEdit) {
	<fieldset id={ layerBlockID(e.Index) }>
		<legend>
			{ tLayer.In(l) } { e.Name }
			<span class="n">— { e.Path } · { strconv.Itoa(len(e.Rules)) } { tLayerRules.In(l) }</span>
		</legend>
		<table>
			<thead>
				<tr>
					<th style="width:7rem">action</th><th style="width:7rem">runtime</th>
					<th>lib</th><th>app_key</th><th>note</th>
				</tr>
			</thead>
			<tbody id={ ruleRowsID(e.Index) }>
				for i, r := range e.Rules {
					@ruleRow(e.Index, i, r)
				}
			</tbody>
		</table>
		@addRuleRow(l, e.Index, len(e.Rules), false)
	</fieldset>
}

// ruleRow — 규칙 한 줄. **화면과 「행 추가」가 같은 조각을 쓴다.**
//
// 칸 이름(action · runtime · lib · app_key · note)은 옮기지 않는다 — pqcota 의 CSV
// 머리글 그대로라, 말을 바꾸면 화면과 파일이 다른 이름으로 같은 것을 가리키게 된다.
templ ruleRow(layer, i int, r scope.Rule) {
	<tr>
		<td>
			<select name={ ruleField(layer, i, "action") }>
				<option value="include" selected?={ r.Action != "exclude" }>include</option>
				<option value="exclude" selected?={ r.Action == "exclude" }>exclude</option>
			</select>
		</td>
		<td><input type="text" name={ ruleField(layer, i, "runtime") } value={ r.Runtime } placeholder="*"/></td>
		<td><input type="text" name={ ruleField(layer, i, "lib") } value={ r.Lib } placeholder="*"/></td>
		<td><input type="text" name={ ruleField(layer, i, "app_key") } value={ r.AppKey } placeholder="*"/></td>
		<td><input type="text" name={ ruleField(layer, i, "note") } value={ r.Note }/></td>
	</tr>
}

// addRuleRow — 계층마다 따로인 「행 추가」. 번호가 끊기면 ApplyLayers 가 거기서 읽기를
// 멈추므로, 서버가 다음 번호를 쥐고 버튼을 갈아 끼운다.
templ addRuleRow(l Lang, layer, next int, oob bool) {
	<div class="addrow" id={ "add-rule-" + strconv.Itoa(layer) } { oobAttr(oob)... }>
		<button
			type="button"
			hx-get={ ScopeRowPath + "?layer=" + strconv.Itoa(layer) + "&i=" + strconv.Itoa(next) + "&" + LangParam + "=" + string(l) }
			hx-target={ "#" + ruleRowsID(layer) }
			hx-swap="beforeend"
		>{ tAddRow.In(l) }</button>
	</div>
}

templ ruleRowFragment(l Lang, layer, i int) {
	@ruleRow(layer, i, scope.Rule{Action: "include"})
	@addRuleRow(l, layer, i+1, true)
}
