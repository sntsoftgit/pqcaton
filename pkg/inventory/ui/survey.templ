package ui

import (
	"fmt"
	"strconv"
	"strings"
)

// surveyPage — 대조 결과. **관측을 먼저 보인다** — 그것 없이는 UNOBSERVED가 「없다」인지
// 「못 봤다」인지 읽는 사람이 가를 수 없다(§2.7).
templ surveyPage(v SurveyView) {
	@shell(v.Page) {
		<fieldset>
			<legend>{ tSurveyObserved.In(v.Page.Lang) }</legend>
			@tip(v.Page.Lang, tSurveyObservedHint.In(v.Page.Lang))
			<table>
				<tr>
					<th style="width:14rem">{ tColNode.In(v.Page.Lang) }</th>
					<th>{ tColCollector.In(v.Page.Lang) }</th>
				</tr>
				for _, n := range v.R.SeenNodes() {
					<tr><td><code>{ n }</code></td><td>{ strings.Join(v.R.SeenBy[n], ", ") }</td></tr>
				}
			</table>
			<p style="margin-top:.8rem">
				@templ.Raw(fmt.Sprintf(tObservedCount.In(v.Page.Lang), v.R.ObservedAssets, v.R.ObservedEdges))
			</p>
			<div class="warn-list" style="border-color:var(--line)">
				<strong>{ tNotSeen.In(v.Page.Lang) }</strong>
				if len(v.R.GapLayers()) == 0 && len(v.R.UncoveredNodes()) == 0 {
					<p class="hint">{ tNotSeenNone.In(v.Page.Lang) }</p>
				} else {
					<ul>
						for _, l := range v.R.GapLayers() {
							<li>{ tNotSeenLayer.In(v.Page.Lang) } { layerLabel(v.Page.Lang, l) }</li>
						}
						for _, n := range v.R.UncoveredNodes() {
							<li>{ tNotSeenEdges.In(v.Page.Lang) } <code>{ n }</code></li>
						}
					</ul>
					@tip(v.Page.Lang, tNotSeenHint.In(v.Page.Lang))
				}
			</div>
			if len(v.R.Skipped) > 0 {
				<div class="warn-list">
					<strong>{ tSkipped.In(v.Page.Lang) }</strong>
					<ul>
						for _, s := range v.R.Skipped {
							<li>{ s }</li>
						}
					</ul>
					@tip(v.Page.Lang, tSkippedHint.In(v.Page.Lang))
				</div>
			}
		</fieldset>
		<fieldset>
			<legend>{ tSurveyAssets.In(v.Page.Lang) }</legend>
			@tip(v.Page.Lang, tSurveyAssetsHint.In(v.Page.Lang)+" "+tShadowHint.In(v.Page.Lang))
			<p>
				CONFIRMED <b>{ strconv.Itoa(v.Confirmed) }</b> ·
				UNDECLARED(shadow) <b>{ strconv.Itoa(v.Undeclared) }</b> ·
				UNOBSERVED <b>{ strconv.Itoa(v.Unobserved) }</b>
			</p>
			<table>
				<tr>
					<th>{ tColState.In(v.Page.Lang) }</th>
					<th>{ tColConfidence.In(v.Page.Lang) }</th>
					<th>{ tColNode.In(v.Page.Lang) }</th>
					<th>{ tColRuntime.In(v.Page.Lang) }</th>
					<th>{ tColComponent.In(v.Page.Lang) }</th>
				</tr>
				for _, a := range v.Assets {
					<tr>
						<td class={ templ.KV("must", a.State != "CONFIRMED") }>{ a.State }</td>
						<td>{ fmt.Sprintf("%.2f", a.Conf) }</td>
						<td><code>{ a.Node }</code></td>
						<td>{ a.Runtime }</td>
						<td>
							{ a.Component }
							if a.Rescan {
								<span class="hint">{ tRescan.In(v.Page.Lang) }</span>
							}
						</td>
					</tr>
				}
				if len(v.Assets) == 0 {
					<tr><td colspan="5">{ tSurveyNoAssets.In(v.Page.Lang) }</td></tr>
				}
			</table>
		</fieldset>
		<fieldset>
			<legend>{ tSurveyEdges.In(v.Page.Lang) }</legend>
			@tip(v.Page.Lang, tSurveyEdgesHint.In(v.Page.Lang))
			<p>@templ.Raw(fmt.Sprintf(tPostures.In(v.Page.Lang), v.PQC, v.Classical, v.Unknown))</p>
			<table>
				<tr>
					<th style="width:2rem"></th>
					<th>{ tColSrc.In(v.Page.Lang) }</th>
					<th>{ tColDst.In(v.Page.Lang) }</th>
					<th>{ tColPort.In(v.Page.Lang) }</th>
					<th>{ tColProto.In(v.Page.Lang) }</th>
					<th>{ tColGroup.In(v.Page.Lang) }</th>
					<th>{ tColReconcile.In(v.Page.Lang) }</th>
				</tr>
				for _, e := range v.Edges {
					<tr>
						<td>{ e.Mark }</td>
						<td>
							<code>{ e.Src }</code>
							if e.Uncovered {
								<span class="hint">{ tUncoveredSrc.In(v.Page.Lang) }</span>
							}
						</td>
						<td>
							<code>{ e.Dst }</code>
							if e.OffScope {
								<span class="hint">{ tOffScope.In(v.Page.Lang) }</span>
							}
						</td>
						<td>{ portText(e.Port) }</td>
						<td>{ e.Proto }</td>
						<td>
							if e.Group != "" {
								{ e.Group }
							} else {
								<span class="hint">{ gradeLabel(v.Page.Lang, e.Grade) }</span>
							}
						</td>
						<td class={ templ.KV("must", e.State != "CONFIRMED") }>{ e.State }</td>
					</tr>
				}
				if len(v.Edges) == 0 {
					<tr><td colspan="7">{ tSurveyNoEdges.In(v.Page.Lang) }</td></tr>
				}
			</table>
		</fieldset>
		<fieldset>
			<legend>{ tTopology.In(v.Page.Lang) }</legend>
			@tip(v.Page.Lang, tTopologyHint.In(v.Page.Lang))
			if v.SVG != "" {
				<div style="overflow-x:auto">
					@templ.Raw(v.SVG)
				</div>
			} else {
				<p class="hint">@templ.Raw(tNoDot.In(v.Page.Lang))</p>
				@tip(v.Page.Lang, tNoDotHelp.In(v.Page.Lang))
				<textarea readonly style="min-height:12rem">{ v.DOT }</textarea>
			}
		</fieldset>
	}
}
