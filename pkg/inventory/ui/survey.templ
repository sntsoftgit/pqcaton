package ui

import (
	"fmt"
	"strconv"
	"strings"
)

// surveyBody — 대조 결과를 읽는 자리. **껍데기와 갈라 둔다** — 요약을 얹은 새 화면이
// 같은 표를 그대로 쓴다. 이 화면은 적는 자리가 없어서 두 판이 보여 주는 것도 같아야 한다.
templ surveyBody(v SurveyView) {
	<fieldset>
		<legend>{ tSurveyObserved.In(v.Page.Lang) }</legend>
		@tip(v.Page.Lang, tSurveyObservedHint.In(v.Page.Lang))
		<div class="table-wrap">
			<table>
				<tr>
					<th style="width:14rem">{ tColNode.In(v.Page.Lang) }</th>
					<th>{ tColCollector.In(v.Page.Lang) }</th>
				</tr>
				for _, n := range v.R.SeenNodes() {
					<tr><td><code>{ n }</code></td><td>{ strings.Join(v.R.SeenBy[n], ", ") }</td></tr>
				}
			</table>
		</div>
		<p style="margin-top:.8rem">
			@templ.Raw(tObservedCount.F(v.Page.Lang, v.R.ObservedAssets, v.R.ObservedEdges))
		</p>
		<div class="warn-list" style="border-color:var(--line)">
			<strong>{ tNotSeen.In(v.Page.Lang) }</strong>
			if len(v.R.GapLayers()) == 0 && len(v.R.UncoveredNodes()) == 0 {
				<p class="hint">{ tNotSeenNone.In(v.Page.Lang) }</p>
			} else {
				<ul>
					for _, l := range v.R.GapLayers() {
						<li>{ tNotSeenLayer.In(v.Page.Lang) } { layerLabel(v.Page.Lang, l) }</li>
					}
					for _, n := range v.R.UncoveredNodes() {
						<li>{ tNotSeenEdges.In(v.Page.Lang) } <code>{ n }</code></li>
					}
				</ul>
				@tip(v.Page.Lang, tNotSeenHint.In(v.Page.Lang))
			}
		</div>
		if len(v.R.Skipped) > 0 {
			<div class="warn-list">
				<strong>{ tSkipped.In(v.Page.Lang) }</strong>
				<ul>
					for _, s := range v.R.Skipped {
						<li>{ s }</li>
					}
				</ul>
				@tip(v.Page.Lang, tSkippedHint.In(v.Page.Lang))
			</div>
		}
		@jcaUnconfirmed(v.Page.Lang, v.R.JCAUnconfirmed)
	</fieldset>
	<fieldset>
		<legend>{ tSurveyAssets.In(v.Page.Lang) }</legend>
		@tip(v.Page.Lang, tSurveyAssetsHint.In(v.Page.Lang)+" "+tUndeclaredHint.In(v.Page.Lang))
		<p>
			CONFIRMED <b>{ strconv.Itoa(v.Confirmed) }</b> ·
			UNDECLARED <b>{ strconv.Itoa(v.Undeclared) }</b> ·
			UNOBSERVED <b>{ strconv.Itoa(v.Unobserved) }</b>
		</p>
		<div class="table-wrap">
			<table>
				<tr>
					<th>{ tColState.In(v.Page.Lang) }</th>
					<th>{ tColConfidence.In(v.Page.Lang) }</th>
					<th>{ tColNode.In(v.Page.Lang) }</th>
					<th>{ tColRuntime.In(v.Page.Lang) }</th>
					<th>{ tColComponent.In(v.Page.Lang) }</th>
				</tr>
				for _, a := range v.Assets {
					<tr>
						<td class={ templ.KV("must", a.State != "CONFIRMED") }>{ a.State }</td>
						<td>{ fmt.Sprintf("%.2f", a.Conf) }</td>
						<td><code>{ a.Node }</code></td>
						<td>{ a.Runtime }</td>
						<td>
							{ a.Component }
							if a.Rescan {
								<span class="hint">{ tRescan.In(v.Page.Lang) }</span>
							}
							if a.Excluded {
								<span class="hint">{ tSurveyExcluded.In(v.Page.Lang) }</span>
							}
						</td>
					</tr>
				}
				if len(v.Assets) == 0 {
					<tr><td colspan="5">{ tSurveyNoAssets.In(v.Page.Lang) }</td></tr>
				}
			</table>
		</div>
	</fieldset>
	<fieldset>
		<legend>{ tSurveyEdges.In(v.Page.Lang) }</legend>
		@tip(v.Page.Lang, tSurveyEdgesHint.In(v.Page.Lang))
		<p>@templ.Raw(tPostures.F(v.Page.Lang, v.PQC, v.Classical, v.Unknown))</p>
		<div class="table-wrap">
			<table class="edges">
				<tr>
					<th style="width:2rem"></th>
					<th>{ tColSrc.In(v.Page.Lang) }</th>
					<th>{ tColDst.In(v.Page.Lang) }</th>
					<th>{ tColPort.In(v.Page.Lang) }</th>
					<th>{ tColProto.In(v.Page.Lang) }</th>
					<th>{ tColGroup.In(v.Page.Lang) }</th>
					<th>{ tColReconcile.In(v.Page.Lang) }</th>
				</tr>
				for _, e := range v.Edges {
					<tr>
						<td>{ e.Mark }</td>
						<td>
							<code>{ e.Src }</code>
							if e.Uncovered {
								<span class="hint">{ tUncoveredSrc.In(v.Page.Lang) }</span>
							}
							if e.OffScopeSrc {
								<span class="hint">{ tOffScope.In(v.Page.Lang) }</span>
							}
						</td>
						<td>
							<code>{ e.Dst }</code>
							if e.OffScope {
								<span class="hint">{ tOffScope.In(v.Page.Lang) }</span>
							}
							if e.ServerOnly {
								<span class="hint" data-edge-server-only>{ tServerOnly.In(v.Page.Lang) }</span>
							}
						</td>
						<td>{ portText(e.Port) }</td>
						<td>{ e.Proto }</td>
						<td>
							if e.Group != "" {
								{ e.Group }
							} else {
								<span class="hint">{ gradeLabel(v.Page.Lang, e.Grade) }</span>
							}
						</td>
						<td class={ templ.KV("must", e.State != "CONFIRMED") }>{ e.State }</td>
					</tr>
				}
				if len(v.Edges) == 0 {
					<tr><td colspan="7">{ tSurveyNoEdges.In(v.Page.Lang) }</td></tr>
				}
			</table>
		</div>
		if len(v.Unconfirmed) > 0 {
			<p data-edges-unconfirmed={ strconv.Itoa(len(v.Unconfirmed)) }><b>{ tUnconfirmedEdges.F(v.Page.Lang, len(v.Unconfirmed)) }</b></p>
			<p class="hint">{ tUnconfirmedEdgesHint.In(v.Page.Lang) }</p>
			<div class="table-wrap">
				<table class="edges">
					<tr>
						<th>{ tColNode.In(v.Page.Lang) }</th>
						<th>{ tColPeer.In(v.Page.Lang) }</th>
						<th>{ tColProto.In(v.Page.Lang) }</th>
					</tr>
					for _, u := range v.Unconfirmed {
						<tr>
							<td><code>{ u.Node }</code></td>
							<td>
								<code>{ u.Peer }</code>
								if u.OffScopePeer {
									<span class="hint">{ tOffScope.In(v.Page.Lang) }</span>
								}
							</td>
							<td>{ u.Proto }</td>
						</tr>
					}
				</table>
			</div>
		}
	</fieldset>
	<fieldset>
		<legend>{ tTopology.In(v.Page.Lang) }</legend>
		@tip(v.Page.Lang, tTopologyHint.In(v.Page.Lang))
		<p><a class="quiet" href={ templ.SafeURL(SurveyDotPath) } download="pqcaton-topology.dot" data-survey-dot>{ tDotDownload.In(v.Page.Lang) }</a></p>
		<div id="survey-picture" hx-get={ SurveyPicturePath + "?" + LangParam + "=" + string(v.Page.Lang) } hx-trigger="load" hx-swap="innerHTML">
			@picturePlace(v.Page.Lang, tSurveyPicturePending.In(v.Page.Lang))
		</div>
		<p style="margin-top:.8rem">
			<a class="quiet" href={ templ.SafeURL(ScreenHistTopo) } data-hist-topo-link>{ tHistTopoTitle.In(v.Page.Lang) }</a>
		</p>
		<p class="hint">{ tHistTopoLinkHint.In(v.Page.Lang) }</p>
	</fieldset>
}

// jcaUnconfirmed — JCA 결과는 있는데 PQC 서비스 목록을 확인할 수 없는 노드. 판을 단정하지 않고 확인을 권한다. 03 · 04가 함께 쓴다.
templ jcaUnconfirmed(lang Lang, nodes []string) {
	if len(nodes) > 0 {
		<div class="warn-list" role="status">
			<strong>{ tJCAUnconfirmed.In(lang) }</strong>
			<ul>
				for _, n := range nodes {
					<li><code>{ n }</code></li>
				}
			</ul>
		</div>
	}
}

// surveyPictureBody — 04의 그림 조각. 그리지 못했으면 까닭과 DOT 원문을 보인다(다른 기계에서 그릴 수 있게).
templ surveyPictureBody(lang Lang, svg, state, dot string, unreadable bool) {
	if unreadable {
		<p class="hint" data-picture="unreadable">{ tSurveyPictureUnreadable.In(lang) }</p>
	} else if svg != "" {
		<div class="picture-scroll" data-survey-picture>
			@templ.Raw(svg)
		</div>
	} else {
		@pictureMissing(lang, state)
		<textarea readonly style="min-height:12rem" aria-label="DOT">{ dot }</textarea>
	}
}

// picturePlace — 그림이 들어올 자리의 첫 내용. **진행 문구는 그림 요청이 실제로 나가 있는 동안에만 보인다**(끼워 넣는 쪽이
// 요청 중인 자리에 붙이는 표시로 켠다). 스크립트를 끈 브라우저에서는 요청이 시작되지 않으므로 「그리고 있습니다」가 보이지
// 않고, 그림 없이도 DOT을 받을 수 있다는 말만 남는다. DOT 링크는 이 자리 밖, 첫 HTML에 있다.
templ picturePlace(lang Lang, progress string) {
	<p class="hint" data-picture="place">{ tPicturePlace.In(lang) }</p>
	<p class="hint picture-progress" data-picture="pending" role="status">{ progress }</p>
}

// pictureMissing — 그림이 없는 까닭. `dot`이 없는 것(선택 사항)과 그렸지만 싣지 않는 것을 가른다. 04와 이력 화면이 함께 쓴다.
templ pictureMissing(lang Lang, state string) {
	switch state {
		case PictureRefused:
			<p class="hint" data-picture="refused">{ tSVGRefused.In(lang) }</p>
		case PictureFailed:
			<p class="hint" data-picture="failed">@templ.Raw(tSVGFailed.In(lang))</p>
		case PictureTimeout:
			<p class="hint" data-picture="timeout">{ tSVGTimeout.In(lang) }</p>
		case PictureTooLarge:
			<p class="hint" data-picture="too-large">{ tSVGTooLarge.In(lang) }</p>
		default:
			<p class="hint" data-picture="no-dot">@templ.Raw(tNoDot.In(lang))</p>
			@tip(lang, tNoDotHelp.In(lang))
	}
}
