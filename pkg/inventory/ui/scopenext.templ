package ui

import "fmt"
import "strconv"

// scopeNextPage — 스코프 화면의 다음 판. 선언과 같은 짜임이다(declNextPage).
//
// **이 화면의 급한 일은 「판정을 기다리는 변경」이다.** 그 가운데 왜 뺐는지를 적어야
// 확정되는 것이 따로 있어서, 수를 나눠 적지 않으면 사람은 다 승인해 놓고 왜 확정이
// 막히는지 모른다.
templ scopeNextPage(v ScopeView) {
	@nextShell(v.Page) {
		<div class="ui-next">
			<p class="eyebrow">{ tNextScopeEyebrow.In(v.Page.Lang) }</p>
			<h2>{ tNextScopeHead.In(v.Page.Lang) }</h2>
			<p class="lede">{ tNextScopeLede.In(v.Page.Lang) }</p>
			@scopeNextTodo(v)
			@scopeNextMetrics(v)
			if len(v.Editing) > 0 {
				<div class="section-label">
					<h3>{ tNextLayerSection.In(v.Page.Lang) }</h3>
					<span>{ tNextLayerNote.In(v.Page.Lang) }</span>
				</div>
				<div class="card-list">
					for _, e := range v.Editing {
						@layerCard(v.Page.Lang, e)
					}
				</div>
			}
			<h3 id={ scopeEditAnchor }>{ tNextScopeEditHead.In(v.Page.Lang) }</h3>
			<p class="lede">{ tNextScopeEditLede.In(v.Page.Lang) }</p>
			@scopeForm(v)
		</div>
	}
}

// scopeNextTodo — 다음에 할 일. **근거가 필요한 수를 따로 적는다** — 다 승인해 놓고
// 확정이 막히면 사람은 무엇이 모자란지 화면에서 알 수 없다.
templ scopeNextTodo(v ScopeView) {
	{{ s := v.Summary() }}
	if s.Changes > 0 {
		<div class="next">
			<div class="next-icon">!</div>
			<div>
				<strong>{ fmt.Sprintf(tNextScopeTodo.In(v.Page.Lang), s.Changes) }</strong>
				if s.Audited > 0 {
					<span>{ fmt.Sprintf(tNextScopeAudited.In(v.Page.Lang), s.Audited) }</span>
				}
			</div>
			<a class="primary" href={ templ.SafeURL("#" + scopeEditAnchor) }>{ tNextScopeGo.In(v.Page.Lang) }</a>
		</div>
	} else {
		<div class="next done">
			<div class="next-icon">✓</div>
			<div>
				<strong>{ tNextScopeDone.In(v.Page.Lang) }</strong>
				<span>{ fmt.Sprintf(tNextScopeDoneBody.In(v.Page.Lang), s.Rules) }</span>
			</div>
		</div>
	}
}

templ scopeNextMetrics(v ScopeView) {
	{{ s := v.Summary() }}
	<div class="metrics">
		<div class="metric">
			<b>{ strconv.Itoa(s.Layers) }</b>
			<span>{ tNextScopeMetricLayers.In(v.Page.Lang) }</span>
		</div>
		<div class="metric">
			<b>{ strconv.Itoa(s.Rules) }</b>
			<span>{ tNextScopeMetricRules.In(v.Page.Lang) }</span>
		</div>
		<div class={ "metric", templ.KV("warn", s.Changes > 0) }>
			<b>{ strconv.Itoa(s.Changes) }</b>
			<span>{ tNextScopeMetricChanges.In(v.Page.Lang) }</span>
		</div>
	</div>
}

// layerCard — 계층 하나. **순서가 곧 상속이라** 적힌 차례대로 그린다.
templ layerCard(l Lang, e LayerEdit) {
	<article class="node-card layer-card">
		<div>
			<strong>{ e.Name }</strong>
			<span title={ e.Path }><code>{ baseName(e.Path) }</code></span>
		</div>
		<div>
			<span>{ fmt.Sprintf(tNextLayerRules.In(l), len(e.Rules)) }</span>
		</div>
		<span class="tag">{ strconv.Itoa(e.Index + 1) }</span>
		<a class="quiet" href={ templ.SafeURL("#" + layerBlockID(e.Index)) }>{ tNextGoEdit.In(l) }</a>
	</article>
}
