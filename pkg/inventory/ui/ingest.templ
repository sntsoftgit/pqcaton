package ui

import "strconv"

// observeIngest — 02의 「이력에 적재」. 관측이 끝났다고 스스로 적재하지 않는다: 운영자가 확인 화면을 거쳐 누른다.
//
// 활성화할 확정 정책으로 재적재가 끝나 활성화를 기다리는 동안에는(v.FoldIngest) 이 구역을 접어 둔다. 그때의 주 동작은 정책
// 활성화 확인이고, 여기서 적재하면 최신 참조가 현재 활성 정책의 것으로 돌아가기 때문이다. 마지막 적재의 기록은 접지 않는다.
templ observeIngest(v ObserveView) {
	if v.FoldIngest() {
		<details id="observe-ingest" class="ingest-fold" data-ingest-fold>
			<summary>{ tIngestFoldSummary.In(v.Page.Lang) }</summary>
			<p class="msg bad" data-ingest-fold-warn>{ tIngestFoldWarn.In(v.Page.Lang) }</p>
			@observeIngestBody(v, true)
		</details>
	} else {
		<h3 id="observe-ingest">{ tIngestHead.In(v.Page.Lang) }</h3>
		<p class="lede">{ tIngestLede.In(v.Page.Lang) }</p>
		@observeIngestBody(v, false)
	}
	@observeIngestLast(v)
}

// observeIngestBody — 적재할 수 있는가와 적재 확인으로 가는 단추. folded면 단추가 주 동작이 아니다.
templ observeIngestBody(v ObserveView, folded bool) {
	if v.Ingest.Running {
		@ingestRunning(v.Page.Lang)
	} else if !v.Ingest.Configured {
		<div class="msg" data-ingest="not-configured">
			<p>{ tIngestNotConfigured.In(v.Page.Lang) }</p>
		</div>
		@tip(v.Page.Lang, tIngestTerminal.In(v.Page.Lang))
	} else if v.Ingest.Block != "" {
		<p class="msg bad" data-ingest-block={ v.Ingest.Block }>{ v.Ingest.BlockText(v.Page.Lang) }</p>
	} else if len(v.Ingest.Problems) > 0 {
		<section class="problems" aria-labelledby="ingest-problems" data-ingest="refused">
			<h3 id="ingest-problems">{ tIngestProblemsHead.F(v.Page.Lang, len(v.Ingest.Problems)) }</h3>
			<p class="lede">{ tIngestProblemsLede.In(v.Page.Lang) }</p>
			<ul>
				for _, p := range v.Ingest.Problems {
					<li data-ingest-why={ p.Why }>
						<code>{ p.File }</code>
						if p.Collector != "" {
							{ " " }
							<code>{ p.Collector }</code>
						}
						{ " " + p.Text(v.Page.Lang) }
					</li>
				}
			</ul>
		</section>
	} else {
		<p class="hint" data-ingest-summary>
			if v.Ingest.NoPolicy {
				{ tIngestSummaryNoPolicy.F(v.Page.Lang, v.Ingest.Files, v.Ingest.Observed) }
			} else {
				{ tIngestSummary.F(v.Page.Lang, v.Ingest.Files, shortPolicy(v.Page.Lang, v.Ingest.PolicyDigest), v.Ingest.Observed-v.Ingest.Managed, v.Ingest.Observed) }
			}
		</p>
		if v.Ingest.StateUnknown {
			<p class="msg bad" data-ingest="state-unknown">{ tIngestStateUnknown.In(v.Page.Lang) }</p>
		} else if v.Ingest.AllCurrent {
			<p class="msg ok" data-ingest="already">{ tIngestAlready.In(v.Page.Lang) }</p>
		}
		@ingestNodes(v.Page.Lang, v.Ingest.Nodes, false)
		if v.Ingest.CanIngest() {
			<form method="post" action={ templ.SafeURL(IngestConfirmPath) }>
				@csrfField(v.Page)
				<div class="actions">
					if folded {
						<button data-ingest-go>{ tIngestFoldGo.In(v.Page.Lang) }</button>
					} else {
						<button class="primary" data-ingest-go>{ tIngestGo.In(v.Page.Lang) }</button>
					}
					@tip(v.Page.Lang, tIngestGoHint.In(v.Page.Lang))
				</div>
			</form>
		}
	}
}

// observeIngestLast — 가장 최근(또는 주소로 요청한) 적재의 기록.
templ observeIngestLast(v ObserveView) {
	if v.Ingest.Last != nil {
		<section id="ingest-last" data-ingest-run={ v.Ingest.Last.ID } data-ingest-outcome={ v.Ingest.Last.Outcome() } data-ingest-reason={ v.Ingest.Last.Reason }>
			<h3>{ tIngestLastHead.F(v.Page.Lang, v.Ingest.Last.Started.UTC().Format("2006-01-02 15:04:05 UTC")) }</h3>
			<p class="hint">{ tProvRunID.F(v.Page.Lang, v.Ingest.Last.ID) }</p>
			if v.Ingest.Last.Candidate {
				<p class="hint" data-ingest-policy="candidate">{ tIngestLastCandidate.F(v.Page.Lang, shortPolicy(v.Page.Lang, v.Ingest.Last.PolicyDigest)) }</p>
			} else {
				<p class="hint" data-ingest-policy="active">{ tIngestLastActive.F(v.Page.Lang, shortPolicy(v.Page.Lang, v.Ingest.Last.PolicyDigest)) }</p>
			}
			if !v.Ingest.Last.Latest && !v.Ingest.Last.Running {
				<p class="hint" data-ingest-shown="requested">{ tIngestShownRun.In(v.Page.Lang) }</p>
			}
			if v.Ingest.Last.Failed() {
				<p class="msg bad" data-ingest-ended>{ v.Ingest.Last.ReasonText(v.Page.Lang) }</p>
				<p class="msg" data-ingest-history>{ tIngestReadBack.In(v.Page.Lang) }{ v.Ingest.Last.OutcomeText(v.Page.Lang) }</p>
			} else {
				<p class={ "msg", templ.KV("ok", v.Ingest.Last.Outcome() == "recorded"), templ.KV("bad", v.Ingest.Last.Outcome() != "recorded" && v.Ingest.Last.Outcome() != "running") }>
					{ v.Ingest.Last.OutcomeText(v.Page.Lang) }
				</p>
				if v.Ingest.Last.ReasonText(v.Page.Lang) != "" {
					<p class="hint" data-ingest-ended>{ v.Ingest.Last.ReasonText(v.Page.Lang) }</p>
				}
			}
			@ingestNodes(v.Page.Lang, v.Ingest.Last.Nodes, true)
		</section>
	}
}

// observePolicy — 02의 「활성화할 확정 정책: 재적재와 활성화」. 두 지문을 나란히 보이고, 두 일을 순서 있는 목록으로 둔다:
// 활성화할 확정 정책으로 재적재 → 정책 활성화. **둘은 따로다.** 재적재가 끝나도 활성 정책은 그대로이고, 활성화 단추는 모든 노드의
// 최신 참조가 활성화할 확정 정책의 것일 때만 나오며 확인 페이지를 거친다.
templ observePolicy(p Page, v ObservePolicy) {
	<h3 id={ scopeActivateAnchor }>{ tPolicyHead.In(p.Lang) }</h3>
	<p class="lede">{ tPolicyLede.In(p.Lang) }</p>
	<div class="table-wrap">
		<table class="provrun" data-policy-pair>
			<tr>
				<th>{ tPolicyColPolicy.In(p.Lang) }</th>
				<th>{ tPolicyColFile.In(p.Lang) }</th>
				<th>{ tPolicyColDigest.In(p.Lang) }</th>
			</tr>
			<tr data-policy="active">
				<td>{ tPolicyActive.In(p.Lang) }</td>
				<td><code>{ v.ActiveFile }</code></td>
				<td><code>{ v.Offer.From }</code></td>
			</tr>
			<tr data-policy="candidate">
				<td>{ tPolicyCandidate.In(p.Lang) }</td>
				<td><code>{ v.CandidateFile }</code></td>
				<td><code>{ v.Offer.To }</code></td>
			</tr>
		</table>
	</div>
	<ol class="activation-steps">
		<li data-policy-step="reingest">
			<strong>{ tPolicyStep1.In(p.Lang) }</strong>
			<span>{ tPolicyStep1Body.In(p.Lang) }</span>
			if v.Ingest.Running {
				<p class="msg" role="status">{ tIngestRunning.In(p.Lang) }</p>
			} else if v.Ingest.Block != "" {
				<p class="msg bad" data-policy-block={ v.Ingest.Block }>{ v.Ingest.BlockText(p.Lang) }</p>
			} else if len(v.Ingest.Problems) > 0 {
				<p class="msg bad" data-policy-block="problems">{ tPolicySeeBelow.In(p.Lang) }</p>
			} else {
				<p class="hint" data-policy-summary>{ tPolicySummary.F(p.Lang, v.Ingest.Files, v.Ingest.Observed-v.Ingest.Managed, v.Ingest.Observed) }</p>
				if v.Ingest.StateUnknown {
					<p class="msg bad" data-policy-state="unknown">{ tIngestStateUnknown.In(p.Lang) }</p>
				} else if v.Ingest.AllCurrent {
					<p class="msg ok" data-policy-state="reingested">{ tPolicyReingested.In(p.Lang) }</p>
				}
				@ingestNodes(p.Lang, v.Ingest.Nodes, false)
				if v.Ingest.CanIngest() {
					<form method="post" action={ templ.SafeURL(IngestConfirmPath) }>
						@csrfField(p)
						<input type="hidden" name={ IngestPolicyField } value={ IngestPolicyCandidate }/>
						<div class="actions">
							<button class="primary" data-policy-go>{ tPolicyGo.In(p.Lang) }</button>
							@tip(p.Lang, tIngestGoHint.In(p.Lang))
						</div>
					</form>
				} else if !v.Ingest.Configured && !v.Ingest.AllCurrent {
					<p class="msg" data-policy-terminal>{ tPolicyTerminal.In(p.Lang) }</p>
					<code>{ v.Offer.VerifyCommand() }</code>
					<code>{ v.Offer.IngestCommand() }</code>
					<span class="hint">{ tActivateStep1Body.In(p.Lang) } { tActivateStep1Hint.In(p.Lang) }</span>
				}
			}
		</li>
		<li data-policy-step="activate">
			<strong>{ tPolicyStep2.In(p.Lang) }</strong>
			if v.CanActivate() {
				<span>{ tPolicyReady.In(p.Lang) }</span>
				<form method="post" action={ templ.SafeURL(ReviewScopeActivateConfirmPath) }>
					<input type="hidden" name={ CSRFField } value={ p.CSRF }/>
					<input type="hidden" name={ RevField } value={ v.ActivateRev }/>
					<input type="hidden" name={ ActivateFromField } value={ ActivateFromObserve }/>
					<div class="actions">
						<button class="primary" data-policy-activate>{ tActivateNext.In(p.Lang) }</button>
					</div>
				</form>
			} else {
				<span data-policy-activate-wait>{ tPolicyNotYet.In(p.Lang) }</span>
			}
		</li>
	</ol>
}

// ingestNodes — 노드마다 기대하는 참조와 이력의 지금 상태. 적재 기록에서는 적재 전의 최신 참조도 함께 보인다.
templ ingestNodes(l Lang, nodes []IngestNode, withBefore bool) {
	if len(nodes) > 0 {
		<div class="table-wrap">
			<table class="provrun">
				<tr>
					<th>{ tProvColNode.In(l) }</th>
					if withBefore {
						<th>{ tIngestColBefore.In(l) }</th>
					}
					<th>{ tIngestColWant.In(l) }</th>
					<th>{ tIngestColLatest.In(l) }</th>
					<th>{ tIngestColState.In(l) }</th>
				</tr>
				for _, n := range nodes {
					<tr data-ingest-node={ n.Node } data-ingest-state={ n.State() } data-ingest-body={ strconv.FormatBool(n.Body) }>
						<td><code>{ n.Node }</code></td>
						if withBefore {
							<td><code>{ shortRef(l, n.Before) }</code></td>
						}
						<td><code>{ shortRef(l, n.Want) }</code></td>
						<td>
							if n.Unknown {
								{ tIngestUnknownCell.In(l) }
							} else {
								<code>{ shortRef(l, n.Latest) }</code>
							}
						</td>
						<td>{ n.StateText(l) }</td>
					</tr>
				}
			</table>
		</div>
	}
}

// ingestRunning — 도는 동안 2초마다 다시 받는다. 끝나면 서버가 화면을 통째로 새로 받게 한다.
templ ingestRunning(l Lang) {
	<div id="ingest-running" hx-get={ IngestPath + "?" + LangParam + "=" + string(l) } hx-trigger="every 2s" hx-swap="outerHTML">
		<p class="msg" role="status">{ tIngestRunning.In(l) }</p>
	</div>
}
