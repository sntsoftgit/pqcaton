package ui

import (
	"strconv"
	"strings"
)

// declPage — 선언 편집. 화면은 적는 자리만 내놓는다 — 앞뒤가 맞는지는 저장한 뒤
// 명령(`pqcaton-report`)과 검토 화면이 짚는다.
templ declPage(v DeclView) {
	@shell(v.Page) {
		<form method="post" action="/decl/save">
			<fieldset>
				<legend>{ tDeclOrg.In(v.Page.Lang) }</legend>
				@tip(v.Page.Lang, tDeclOrgHint.In(v.Page.Lang))
				<input type="text" name="org" value={ v.Decl.Org } placeholder="local"/>
			</fieldset>
			<fieldset>
				<legend>{ tDeclScope.In(v.Page.Lang) }</legend>
				@tip(v.Page.Lang, tDeclScopeHint.In(v.Page.Lang)+" "+tDeclNodesHint.In(v.Page.Lang))
				<table>
					<thead>
						<tr>
							<th style="width:14rem">{ tColName.In(v.Page.Lang) }</th>
							<th>{ tColIP.In(v.Page.Lang) }</th>
						</tr>
					</thead>
					<tbody id={ rowsID(KindNode) }>
						for i, n := range v.Decl.Nodes {
							@nodeRow(i, n.Name, strings.Join(n.IPs, ", "))
						}
					</tbody>
				</table>
				@addRow(v.Page.Lang, KindNode, len(v.Decl.Nodes), false)
			</fieldset>
			<fieldset>
				<legend>{ tDeclAssets.In(v.Page.Lang) }</legend>
				@tip(v.Page.Lang, tDeclAssetsHint.In(v.Page.Lang))
				<table>
					<thead>
						<tr>
							<th style="width:12rem">{ tColNode.In(v.Page.Lang) }</th>
							<th style="width:8rem">{ tColRuntime.In(v.Page.Lang) }</th>
							<th>{ tColComponent.In(v.Page.Lang) }</th>
						</tr>
					</thead>
					<tbody id={ rowsID(KindAsset) }>
						for i, a := range v.Decl.Assets {
							@assetRow(i, a.Node, a.Runtime, a.Component)
						}
					</tbody>
				</table>
				@addRow(v.Page.Lang, KindAsset, len(v.Decl.Assets), false)
			</fieldset>
			<fieldset>
				<legend>{ tDeclEdges.In(v.Page.Lang) }</legend>
				@tip(v.Page.Lang, tDeclEdgesHint.In(v.Page.Lang))
				<table>
					<thead>
						<tr>
							<th style="width:11rem">{ tColSrc.In(v.Page.Lang) }</th>
							<th style="width:11rem">{ tColDst.In(v.Page.Lang) }</th>
							<th style="width:6rem">{ tColPort.In(v.Page.Lang) }</th>
							<th>{ tColProto.In(v.Page.Lang) }</th>
						</tr>
					</thead>
					<tbody id={ rowsID(KindEdge) }>
						for i, e := range v.Decl.Edges {
							@edgeRow(i, e.Src, e.Dst, portText(e.Port), e.Proto)
						}
					</tbody>
				</table>
				@addRow(v.Page.Lang, KindEdge, len(v.Decl.Edges), false)
			</fieldset>
			<div class="actions">
				<button class="primary">{ tDeclSave.In(v.Page.Lang) }</button>
				@tip(v.Page.Lang, tDeclSaveHint.In(v.Page.Lang))
			</div>
		</form>
	}
}

// nodeRow · assetRow · edgeRow — 표의 한 줄.
//
// **화면과 「행 추가」가 같은 조각을 쓴다.** 두 벌이면 이름이 어긋나는 날이 오고, 그러면
// 새로 넣은 줄만 조용히 저장되지 않는다 — 폼 이름이 곧 저장 경로이기 때문이다.
templ nodeRow(i int, name, ips string) {
	<tr>
		<td><input type="text" name={ "node.name." + strconv.Itoa(i) } value={ name }/></td>
		<td><input type="text" name={ "node.ips." + strconv.Itoa(i) } value={ ips }/></td>
	</tr>
}

templ assetRow(i int, node, runtime, component string) {
	<tr>
		<td><input type="text" name={ "asset.node." + strconv.Itoa(i) } value={ node }/></td>
		<td><input type="text" name={ "asset.runtime." + strconv.Itoa(i) } value={ runtime } placeholder="openssl | jca"/></td>
		<td><input type="text" name={ "asset.component." + strconv.Itoa(i) } value={ component }/></td>
	</tr>
}

templ edgeRow(i int, src, dst, port, proto string) {
	<tr>
		<td><input type="text" name={ "edge.src." + strconv.Itoa(i) } value={ src }/></td>
		<td><input type="text" name={ "edge.dst." + strconv.Itoa(i) } value={ dst }/></td>
		<td><input type="text" name={ "edge.port." + strconv.Itoa(i) } value={ port }/></td>
		<td><input type="text" name={ "edge.proto." + strconv.Itoa(i) } value={ proto } placeholder="TLS | SSH"/></td>
	</tr>
}

// addRow — 「행 추가」 버튼. 다음에 쓸 번호를 자기 주소에 들고 있다.
//
// 번호가 촘촘해야 한다 — `ApplyDecl` 은 번호가 끊기는 자리에서 읽기를 멈추므로, 건너뛴
// 줄 뒤의 것은 **오류 없이 저장되지 않는다.** 그래서 서버가 다음 번호를 쥐고, 줄을 하나
// 내줄 때마다 이 버튼을 자기 자신으로 갈아 끼운다(`hx-swap-oob`).
//
// 말도 주소에 실어 보낸다 — 조각만 받아 오는 요청이라 쿠키에 기대지 않는다.
templ addRow(l Lang, kind string, next int, oob bool) {
	<div class="addrow" id={ "add-" + kind } { oobAttr(oob)... }>
		<button
			type="button"
			hx-get={ RowPath + "?kind=" + kind + "&i=" + strconv.Itoa(next) + "&" + LangParam + "=" + string(l) }
			hx-target={ "#" + rowsID(kind) }
			hx-swap="beforeend"
		>{ tAddRow.In(l) }</button>
	</div>
}

// rowFragment — 「행 추가」가 돌려주는 것: 새 줄 하나와, 번호가 하나 오른 버튼.
templ rowFragment(l Lang, kind string, i int) {
	switch kind {
		case KindNode:
			@nodeRow(i, "", "")
		case KindAsset:
			@assetRow(i, "", "", "")
		case KindEdge:
			@edgeRow(i, "", "", "", "")
	}
	@addRow(l, kind, i+1, true)
}
