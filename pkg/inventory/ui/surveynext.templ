package ui

import "strconv"

// surveyNextPage — 대조 화면의 다음 판.
//
// **이 화면의 급한 일은 「관측이 어디까지 닿았나」다.** 다시 관측해 봐야 하는 자산이
// 남아 있으면 UNOBSERVED는 아직 「없다」가 아니라 「못 봤다」이고, 그것을 부재로 확정하면
// 실재하는 자산이 장부에서 사라진다. 그래서 판정 수보다 그것을 먼저 띄운다.
templ surveyNextPage(v SurveyView) {
	@nextShell(v.Page) {
		<div class="ui-next">
			{{ s := v.Summary() }}
			<p class="eyebrow">{ tNextSurveyEyebrow.In(v.Page.Lang) }</p>
			if s.ToJudge > 0 {
				<h2>{ tNextSurveyHead.F(v.Page.Lang, s.ToJudge) }</h2>
			} else {
				<h2>{ tNextSurveyHeadDone.In(v.Page.Lang) }</h2>
			}
			<p class="lede">{ tNextSurveyLede.In(v.Page.Lang) }</p>
			@surveySource(v)
			@surveyNextMetrics(v)
			@surveyActivationNote(v)
			@surveyNextTodo(v)
			<h3 id={ surveyEditAnchor }>{ tNextSurveyDetail.In(v.Page.Lang) }</h3>
			<p class="lede">{ tNextSurveyDetailLede.In(v.Page.Lang) }</p>
			@surveyBody(v)
		</div>
	}
}

// surveyNextMetrics — 세 상태를 그대로 센다. **이름을 옮기지 않는다** — 화면과 명령과
// 원장이 같은 낱말을 써야 같은 것을 가리킨다.
templ surveyNextMetrics(v SurveyView) {
	{{ s := v.Summary() }}
	<div class="metrics">
		<div class={ "metric", templ.KV("danger", s.Undeclared > 0) }>
			<b>{ strconv.Itoa(s.Undeclared) }</b>
			<span>UNDECLARED</span>
		</div>
		<div class={ "metric", templ.KV("warn", s.Unobserved > 0) }>
			<b>{ strconv.Itoa(s.Unobserved) }</b>
			<span>UNOBSERVED</span>
		</div>
		<div class="metric ok">
			<b>{ strconv.Itoa(s.Confirmed) }</b>
			<span>CONFIRMED</span>
		</div>
	</div>
}

// surveyActivationNote — 자산 스코프 화면에서 확정한 정책이 아직 활성화되지 않았을 때. **이 대조가 어느 정책으로 한 것인지 먼저
// 밝힌다.** 확정한 정책이 이미 쓰이는 줄 알고 이 화면을 읽으면, 새 정책에서 빠질 자산을 아직 관리 대상으로 본다. 활성화는
// 상류 재적재와 새 판정 회차를 함께 거치므로 02 관측 화면의 「활성화할 확정 정책」 한 곳에서만 한다. 여기서는 그리로 잇는다.
templ surveyActivationNote(v SurveyView) {
	if v.Activation != nil {
		<div class="next ruleset" role="status">
			<div class="next-icon">!</div>
			<div>
				<strong>{ tSurveyActivateHead.In(v.Page.Lang) }</strong>
				<span>{ tSurveyActivateBody.In(v.Page.Lang) }</span>
				<span class="hint">{ tSurveyActivatePolicy.In(v.Page.Lang) } <code>{ v.Activation.From }</code> → <code>{ v.Activation.To }</code></span>
			</div>
			<a class="primary" href={ templ.SafeURL(ScreenObserve + "#" + scopeActivateAnchor) }>{ tSurveyActivateGo.In(v.Page.Lang) }</a>
		</div>
	}
}

// surveyNextTodo — 다음에 할 일. **재수집 후보가 판정보다 앞선다** — 못 본 것을 없는
// 것으로 확정하는 실수가 이 도구가 막으려는 바로 그 자리다.
templ surveyNextTodo(v SurveyView) {
	{{ s := v.Summary() }}
	if s.Rescan > 0 {
		<div class="next">
			<div class="next-icon">!</div>
			<div>
				<strong>{ tNextSurveyRescan.In(v.Page.Lang) }</strong>
				<span>{ tNextSurveyRescanBody.F(v.Page.Lang, s.Rescan) }</span>
			</div>
			<a class="quiet" href={ templ.SafeURL("#" + surveyEditAnchor) }>{ tNextGoEdit.In(v.Page.Lang) }</a>
		</div>
	}
	if s.ToJudge > 0 {
		<div class="next">
			<div class="next-icon">!</div>
			<div>
				<strong>{ tNextSurveyJudge.F(v.Page.Lang, s.ToJudge) }</strong>
				<span>{ tNextSurveyJudgeBody.In(v.Page.Lang) }</span>
			</div>
			<a class="primary" href={ templ.SafeURL(ScreenReview) }>{ tNextSurveyGoReview.In(v.Page.Lang) }</a>
		</div>
	} else if s.Rescan == 0 {
		<div class="next done">
			<div class="next-icon">✓</div>
			<div>
				if s.Excluded > 0 {
					<strong>{ tNextSurveyNoneToJudge.In(v.Page.Lang) }</strong>
				} else {
					<strong>{ tNextSurveyDone.In(v.Page.Lang) }</strong>
					<span>{ tNextSurveyDoneBody.In(v.Page.Lang) }</span>
				}
			</div>
		</div>
	}
	if s.Excluded > 0 {
		<p class="hint" data-survey-excluded={ strconv.Itoa(s.Excluded) }>{ tNextSurveyExcluded.F(v.Page.Lang, s.Excluded) }</p>
	}
}

// surveySource — 이 대조가 **어느 결과로** 한 것인가. 대조의 범위는 선언 전체이고, 결과는 관측이 성공으로 끝났을 때만 한
// 세대로 바뀐다. 그래서 가장 최근 실행이 실패했으면 그 앞의 성공 결과로 대조하고 있다: 대조에 쓴 결과의 시각과 실패한 실행의
// 시각을 따로 적는다. 성공 결과가 한 번도 없으면 그것을 먼저 말한다(선언 자산의 미관측이 「찾지 못했다」로 읽히지 않게).
templ surveySource(v SurveyView) {
	if v.Source != nil {
		<div class="msg" data-survey-source={ surveySourceKind(*v.Source) }>
			if v.Source.Empty {
				<p><strong>{ tSurveySrcEmpty.In(v.Page.Lang) }</strong></p>
			} else if v.Source.Outside {
				<p>{ tSurveySrcOutside.F(v.Page.Lang, v.Source.Nodes) }</p>
			} else {
				<p data-survey-source-at>{ tSurveySrcAt.F(v.Page.Lang, v.Source.At.Local().Format("2006-01-02 15:04 MST"), v.Source.Nodes) }</p>
			}
			if !v.Source.LastFailedAt.IsZero() {
				<p data-survey-last-failed>{ tSurveySrcFailed.F(v.Page.Lang, v.Source.LastFailedAt.Local().Format("2006-01-02 15:04 MST"), v.Source.LastFailedState.Short(v.Page.Lang)) }</p>
			}
			if len(v.Source.Absent) > 0 && !v.Source.Empty {
				<p data-survey-absent>{ tSurveySrcAbsent.F(v.Page.Lang, len(v.Source.Absent), nodeNames(v.Source.Absent)) }</p>
			}
		</div>
	}
}

