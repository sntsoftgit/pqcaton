package ui

import "strconv"

// observePage — 02 관측. 관측할 노드에 어떻게 붙는지(접근 정보)를 적는다.
//
// **비밀번호 칸은 없다.** 파일에 있으면 「있음」만 보이고 저장해도 그대로 남는다(observe.go).
templ observePage(v ObserveView) {
	@nextShell(v.Page) {
		<div class="ui-next">
			<p class="eyebrow">{ tObserveEyebrow.In(v.Page.Lang) }</p>
			<h2>{ tObserveHead.In(v.Page.Lang) }</h2>
			<p class="lede">{ tObserveLede.In(v.Page.Lang) }</p>
			@hostProblemList(v)
			<div class="metrics">
				<div class={ "metric", templ.KV("warn", len(v.Hosts) == 0) }>
					<b>{ strconv.Itoa(len(v.Hosts)) }</b>
					<span>{ tObserveMetricHosts.In(v.Page.Lang) }</span>
				</div>
			</div>
			<h3>{ tHostsHead.In(v.Page.Lang) }</h3>
			<p class="lede">{ tHostsLede.In(v.Page.Lang) }</p>
			@hostsForm(v)
			<h3 id="observe-run">{ tRunHead.In(v.Page.Lang) }</h3>
			<p class="lede">{ tRunLede.In(v.Page.Lang) }</p>
			// 실행 상태가 시작 전 점검보다 위다. 시작하면 이 자리(#observe-run)로 오는데, 점검 목록이 길어 좁은 화면에서는
			// 그 아래에 둔 상태와 중지 버튼이 화면 밖에 있었다.
			@runStatus(v.Page.Lang, v.Page.CSRF, v.Run.Status)
			@runChecks(v.Page.Lang, v.Run)
			if v.Run.CanStart() {
				<form method="post" action={ templ.SafeURL(RunPath) } class="run-start">
					<input type="hidden" name={ CSRFField } value={ v.Page.CSRF }/>
					<label>
						{ tRunWindow.In(v.Page.Lang) }
						<input type="number" name="window" min="5" max="3600" value={ strconv.Itoa(v.Run.Window) }/>
					</label>
					<div class="actions">
						<button class="primary">{ tRunStart.In(v.Page.Lang) }</button>
						@tip(v.Page.Lang, tRunStartHint.In(v.Page.Lang))
					</div>
				</form>
			}
			if v.Run.Current != nil {
				<p class="lede">{ tRunCurrent.F(v.Page.Lang, v.Run.Current.Ended.Format("2006-01-02 15:04 MST"), v.Run.Current.Nodes, v.Run.Current.Files) }</p>
			}
			// 지금 결과가 화면의 관측에서 왔든 pqcota 수집에서 왔든 같은 경고를 낸다.
			@jcaUnconfirmed(v.Page.Lang, v.Run.JCAUnconfirmed)
			if v.Scope != nil {
				@observeScope(v.Page, *v.Scope)
			}
			if v.HasResults && v.Policy != nil {
				@observePolicy(v.Page, *v.Policy)
			}
			if v.HasResults {
				@observeIngest(v)
			}
		</div>
	}
}

// runChecks — 시작하기 전에 보는 것. 빠진 것은 무엇을 하면 되는지 함께 적는다.
templ runChecks(l Lang, r ObserveRun) {
	<ul class="checks">
		if !r.Writable {
			<li class="bad">{ tRunNotWritable.In(l) }</li>
		}
		for _, c := range r.Checks {
			<li data-check={ string(c.Item) } class={ templ.KV("ok", c.OK), templ.KV("bad", !c.OK && c.Blocking), templ.KV("warn", !c.OK && !c.Blocking) }>
				if c.OK {
					{ "✓ " }
				} else {
					{ "✗ " }
				}
				<strong>{ c.Text(l) }</strong>
				if c.Detail != "" {
					{ " " }
					<code>{ c.Detail }</code>
				}
				if !c.OK {
					<br/>
					<span>{ c.Missing(l) }</span>
				}
				if len(c.Procs) > 0 {
					@runProcs(l, c.Procs)
				}
				if len(c.Files) > 0 {
					<ul class="collector-files">
						for _, f := range c.Files {
							<li data-collector-state={ f.State } if f.Title(l) != "" { title={ f.Title(l) } }><code>{ f.Path }</code>{ " " }{ f.Line(l) }</li>
						}
					</ul>
				}
			</li>
		}
	</ul>
}

// runStatus — 실행 상태와 로그.
//
// **도는 동안 다시 받는 것은 요약과 로그 두 조각뿐이다.** 상자를 통째로 갈면 그 안의 중지 버튼도 2초마다 갈려, 키보드로
// 그 버튼에 가 있던 포커스가 그때마다 사라진다. 요약(#run-live)과 로그(#run-log)가 따로 다시 받고, 그 사이의 중지 버튼은
// 그대로 있다. 상태가 바뀌면(돌던 것이 마무리 중이 되거나 끝나면) 요약 조각의 응답이 상자 전체를 갈아 끼운다
// (RunPartLive, 처리기가 HX-Retarget을 단다). 끝난 실행은 다시 받지 않는다.
//
// 다시 받는 조각을 통째로 알림 영역으로 두지 않는다. 알림 영역은 상태 요약뿐이다.
templ runStatus(l Lang, csrf string, st *RunStatus) {
	if st == nil {
		<div id="run-status"></div>
	} else {
		<div id="run-status" class="run-status">
			if st.Over() {
				@runSummary(l, st)
			} else {
				@runLive(l, st)
			}
			@runAfter(l, csrf, st)
			if st.Over() {
				@runLog(l, st)
			} else {
				@runLogLive(l, st)
			}
		</div>
	}
}

// runPartURL — 그 조각을 다시 받는 주소. 지금 상태를 함께 싣는다: 서버가 상태가 바뀐 것을 알아보는 데 쓴다.
func runPartURL(l Lang, part string, st *RunStatus) string {
	return RunPath + "?" + LangParam + "=" + string(l) + "&" + RunPartParam + "=" + part + "&" + RunStateParam + "=" + string(st.State)
}

templ runLive(l Lang, st *RunStatus) {
	<div id="run-live" hx-get={ runPartURL(l, RunPartLive, st) } hx-trigger="every 2s" hx-swap="outerHTML">
		@runSummary(l, st)
	</div>
}

templ runLogLive(l Lang, st *RunStatus) {
	<div id="run-log" hx-get={ runPartURL(l, RunPartLog, st) } hx-trigger="every 2s" hx-swap="outerHTML">
		@runLog(l, st)
	</div>
}

// runSummary — 로그를 펼치지 않고도 알 수 있어야 하는 것: 지금 무엇을 하는지(상태 · 단계 · 노드), 언제 시작했는지
// (시간대와 함께), 끝났으면 언제 끝났고 어느 단계에서 멈췄는지.
templ runSummary(l Lang, st *RunStatus) {
	{{ pg := st.Progress() }}
	<div class="run-summary" role="status" aria-live="polite">
		<p><strong>{ st.Text(l) }</strong></p>
		// 지금 단계는 도는 동안에만 적는다. 마무리 중에는 관측이 이미 끝났다(상태 줄이 그것을 말한다).
		if st.State == RunRunning && st.PhaseText(l) != "" {
			<p class="run-phase">{ st.PhaseText(l) }</p>
		}
		if st.Over() && st.StartedText() != "" && st.EndedText() != "" {
			<p class="hint">{ tRunTimes.F(l, st.StartedText(), st.EndedText()) }</p>
		}
		if st.Over() && st.State != RunDone && st.ReachedText(l) != "" {
			<p class="run-phase">{ st.ReachedText(l) }</p>
		}
		if len(pg.Nodes) > 0 {
			<p class="hint">{ tRunNodesHead.In(l) }</p>
			<ul class="run-nodes">
				for _, n := range pg.Nodes {
					<li data-node-state={ n.State }>{ n.Text(l, st.State != RunRunning) }</li>
				}
			</ul>
		}
	</div>
}

// runAfter — 요약 바로 아래: 도는 동안에는 중지 버튼, 끝났으면 다음에 할 일(03으로 가는 길, 또는 정리 결과와 다시 하는 법).
templ runAfter(l Lang, csrf string, st *RunStatus) {
	if st.State == RunRunning {
		<form method="post" action={ templ.SafeURL(RunStopPath) }>
			<input type="hidden" name={ CSRFField } value={ csrf }/>
			<button type="submit">{ tRunStop.In(l) }</button>
			@tip(l, tRunStopHint.In(l))
		</form>
	} else if st.State == RunDone {
		<p><a class="primary" href={ templ.SafeURL(ScreenSurvey + "?" + LangParam + "=" + string(l)) }>{ tRunGoSurvey.In(l) }</a></p>
	}
	switch st.NodeCleanup {
		case "failed":
			<p class="msg bad">{ tRunStagingLeft.F(l, st.StagingPaths()) }</p>
		case "done":
			<p class="hint">{ tRunStagingCleaned.In(l) }</p>
		case "not-needed":
			<p class="hint">{ tRunStagingNotNeeded.In(l) }</p>
	}
	if st.State == RunStopped {
		<p class="hint">{ tRunAgainStopped.In(l) }</p>
	} else if st.State == RunFailed || st.State == RunIncomplete || st.State == RunInterrupted {
		<p class="hint">{ tRunAgain.In(l) }</p>
	}
	if len(st.Missing) > 0 {
		<p><strong>{ tRunMissing.In(l) }</strong></p>
		<ul>
			for _, m := range st.Missing {
				<li><code>{ m }</code></li>
			}
		</ul>
	}
}

// runLog — 상세 로그. 접어 둔다. 펼친 상태는 다시 받아도 유지된다(app.js).
templ runLog(l Lang, st *RunStatus) {
	<details class="run-log-box" data-keep-open="run-log">
		<summary>{ tRunLogDetails.F(l, st.LogLines()) }</summary>
		if st.Dropped > 0 {
			<p class="hint">{ tRunDropped.F(l, st.Dropped) }</p>
		}
		<pre class="run-log" tabindex="0" aria-label={ tRunLog.In(l) }>{ st.Log }</pre>
	</details>
}

// hostProblemList — 저장을 막은 자리. 어느 노드의 무엇이 틀렸는지.
templ hostProblemList(v ObserveView) {
	if len(v.Problems) > 0 {
		<section class="problems" aria-labelledby="host-problems" role="alert">
			<h3 id="host-problems">{ tHostProblemsHead.In(v.Page.Lang) }</h3>
			<ul>
				for _, p := range v.Problems {
					<li><strong>{ p.Node }</strong> · { p.What.In(v.Page.Lang) }</li>
				}
			</ul>
		</section>
	}
}

templ hostsForm(v ObserveView) {
	<form method="post" action={ templ.SafeURL(HostsSavePath) } data-guard="">
		@csrfField(v.Page)
		<fieldset>
			<legend>{ tHostsLegend.In(v.Page.Lang) }</legend>
			@tip(v.Page.Lang, tHostsHint.In(v.Page.Lang))
			<div class="table-wrap">
				<table class="editable" role="table">
					<thead role="rowgroup">
						<tr role="row">
							<th role="columnheader" style="width:6.5rem">{ tColNodeID.In(v.Page.Lang) }</th>
							<th role="columnheader" style="width:7.5rem">{ tColName.In(v.Page.Lang) }</th>
							<th role="columnheader" style="width:7.5rem">{ tColIP.In(v.Page.Lang) }</th>
							<th role="columnheader" style="width:4.5rem">{ tColPort.In(v.Page.Lang) }</th>
							<th role="columnheader" style="width:5.5rem">{ tColUser.In(v.Page.Lang) }</th>
							<th role="columnheader" style="width:28%">{ tColKey.In(v.Page.Lang) }</th>
							<th role="columnheader" style="width:6rem">{ tColOS.In(v.Page.Lang) }</th>
							<th role="columnheader" style="width:5.5rem">{ tColConn.In(v.Page.Lang) }</th>
							<th role="columnheader" style="width:4.5rem">{ tColPass.In(v.Page.Lang) }</th>
							<th role="columnheader" style="width:4rem"></th>
						</tr>
					</thead>
					<tbody role="rowgroup" id={ rowsID(KindHost) }>
						for i, h := range v.Hosts {
							@hostRow(v.Page.Lang, i, h)
						}
					</tbody>
				</table>
			</div>
			@addRow(v.Page.Lang, KindHost, 0, len(v.Hosts), false)
		</fieldset>
		<div class="actions sticky">
			<button class="primary">{ tHostsSave.In(v.Page.Lang) }</button>
			@reloadButton(v.Page.Lang, v.Page.Self)
			@unsavedNote(v.Page.Lang)
		</div>
	</form>
}

// hostRow — 노드 한 대에 붙는 방법. OS와 접속 방법은 상류가 받는 값만 고른다.
templ hostRow(l Lang, i int, h HostRow) {
	{{ n := strconv.Itoa(i) }}
	<tr role="row">
		<td role="cell" data-label={ tColNodeID.In(l) }>
			<input type="hidden" name={ "host.was." + n } value={ h.Was }/>
			<input type="text" name={ "host.id." + n } value={ h.NodeID } aria-label={ rowLabel(l, tRowHost, i+1, tColNodeID.In(l)) }/>
		</td>
		<td role="cell" data-label={ tColName.In(l) }><input type="text" name={ "host.name." + n } value={ h.Name } aria-label={ rowLabel(l, tRowHost, i+1, tColName.In(l)) }/></td>
		<td role="cell" data-label={ tColIP.In(l) }><input type="text" name={ "host.ip." + n } value={ h.IP } aria-label={ rowLabel(l, tRowHost, i+1, tColIP.In(l)) }/></td>
		<td role="cell" data-label={ tColPort.In(l) }><input type="number" min="1" max="65535" name={ "host.port." + n } value={ h.Port } aria-label={ rowLabel(l, tRowHost, i+1, tColPort.In(l)) }/></td>
		<td role="cell" data-label={ tColUser.In(l) }><input type="text" name={ "host.user." + n } value={ h.User } aria-label={ rowLabel(l, tRowHost, i+1, tColUser.In(l)) }/></td>
		<td role="cell" data-label={ tColKey.In(l) }><input type="text" class="wide" name={ "host.key." + n } value={ h.Key } title={ h.Key } placeholder="~/.ssh/id_ed25519" aria-label={ rowLabel(l, tRowHost, i+1, tColKey.In(l)) }/></td>
		<td role="cell" data-label={ tColOS.In(l) }>
			<select name={ "host.os." + n } aria-label={ rowLabel(l, tRowHost, i+1, tColOS.In(l)) }>
				<option value="linux" selected?={ h.OS != "windows" }>Linux</option>
				<option value="windows" selected?={ h.OS == "windows" }>Windows</option>
			</select>
		</td>
		<td role="cell" data-label={ tColConn.In(l) }>
			<select name={ "host.conn." + n } aria-label={ rowLabel(l, tRowHost, i+1, tColConn.In(l)) }>
				<option value="ssh" selected?={ h.Conn != "winrm" }>SSH</option>
				<option value="winrm" selected?={ h.Conn == "winrm" }>WinRM</option>
			</select>
		</td>
		<td role="cell" data-label={ tColPass.In(l) }>
			if h.HasPass {
				{ tPassSet.In(l) }
			} else {
				{ "–" }
			}
		</td>
		<td role="cell" data-label="">@removeButton(l, "tr", tRemoveHostAsk.In(l))</td>
	</tr>
}

// runProcs — 「회수 필요」로 남긴 프로세스의 지금 상태. **끝내는 단추는 두지 않는다.** 끝내는 일은 운영자가 확인한 뒤 한다.
// 「다시 확인」은 같은 화면을 다시 읽을 뿐(GET)이고 아무것도 쓰지 않는다. 인자는 서버에서 가린 값만 온다.
templ runProcs(l Lang, procs []ProcInfo) {
	<h4 id="run-procs">{ tProcHead.In(l) }</h4>
	<ul class="checks">
		for _, p := range procs {
			<li data-proc-state={ string(p.State) } class={ templ.KV("ok", p.State == ProcGone), templ.KV("bad", p.State == ProcSame), templ.KV("warn", p.State != ProcSame && p.State != ProcGone) }>
				<strong>{ tProcPID.In(l) } { strconv.Itoa(p.PID) }</strong>
				<br/>
				<span>{ p.StateText(l) }</span>
				if p.State == ProcSame {
					<dl class="proc">
						<dt>{ tProcPPID.In(l) }</dt><dd><code>{ strconv.Itoa(p.PPID) }</code></dd>
						<dt>{ tProcPGID.In(l) }</dt><dd><code>{ strconv.Itoa(p.PGID) }</code></dd>
						<dt>{ tProcUser.In(l) }</dt><dd><code>{ p.User }</code></dd>
						<dt>{ tProcExe.In(l) }</dt>
						<dd>
							if p.ExeDenied {
								{ tProcNoAccess.In(l) }
							} else {
								<code>{ p.Exe }</code>
							}
						</dd>
						<dt>{ tProcStarted.In(l) }</dt><dd><code>{ p.Started }</code></dd>
					</dl>
					if p.ArgsDenied {
						<p class="hint">{ tProcArgs.In(l) }: { tProcNoAccess.In(l) }</p>
					} else {
						<details><summary>{ tProcArgs.In(l) }</summary><pre class="run-log">{ p.Args }</pre></details>
					}
				}
			</li>
		}
	</ul>
	<p><a href={ templ.SafeURL(ScreenObserve + "?" + LangParam + "=" + string(l) + "#run-procs") }>{ tProcRecheck.In(l) }</a></p>
	@tip(l, tProcRecheckHint.In(l))
}

// observeScope — 02 관측의 「자산 스코프」. 현재 활성 정책의 지문을 여기서 보이고(아래 적재 구역과 지난 적재 기록이 이 값에
// 견줘 읽힌다), 규칙 편집 · 서명 · 확정은 자산 스코프 화면에서 한다.
templ observeScope(p Page, v ObserveScope) {
	<h3 id="observe-scope">{ tObsScopeHead.In(p.Lang) }</h3>
	<p class="lede">{ tObsScopeLede.In(p.Lang) }</p>
	if v.PolicyUnknown {
		<p class="msg bad" data-active-policy="unknown">{ tObsScopeUnknown.In(p.Lang) }</p>
	} else {
		<p data-active-policy>{ tPolicyActiveNow.In(p.Lang) }<code>{ v.ActiveDigest }</code></p>
		<p class="hint" data-active-policy-file>{ tObsScopeFile.F(p.Lang, v.ActiveFile, v.Rules) }</p>
	}
	if v.Href != "" {
		<p data-scope-state>
			if v.Dot != "" {
				<span class={ "dot", v.Dot }></span>
			}
			{ tObsScopeState.F(p.Lang, v.State, v.Final) }
		</p>
		<div class="actions">
			<a class="quiet" href={ templ.SafeURL(v.Href + "?" + LangParam + "=" + string(p.Lang)) } data-scope-edit>{ tObsScopeEdit.In(p.Lang) }</a>
		</div>
	}
}
