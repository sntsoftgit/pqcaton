package ui

import (
	"strconv"

	"github.com/sntsoftgit/pqcaton/pkg/inventory/review"
)

// reviewNextPage — 판정 화면의 다음 판.
//
// **확정을 막는 것이 무엇인지 한 줄로 알린다.** 결론이 빈 정책과 서명은 서로 다른 이유로
// 확정을 막는데, 화면이 둘을 뭉뚱그리면 사람은 결론을 다 채워 놓고 왜 여전히 막히는지
// 모른다. 그래서 남은 것을 갈라 적는다.
templ reviewNextPage(v ReviewView) {
	@nextShell(v.Page) {
		<div class="ui-next">
			<p class="eyebrow">{ tNextReviewEyebrow.In(v.Page.Lang) }</p>
			<h2>{ tNextReviewHead.In(v.Page.Lang) }</h2>
			<p class="lede">{ tNextReviewLede.In(v.Page.Lang) }</p>
			@reviewNextTodo(v)
			@reviewNextMetrics(v)
			<h3 id={ reviewEditAnchor }>{ tNextReviewEditHead.In(v.Page.Lang) }</h3>
			<p class="lede">{ tNextReviewEditLede.In(v.Page.Lang) }</p>
			@rulesetReport(v)
			@scopeRoundNote(v)
			@reviewForm(v)
		</div>
	}
}

// reviewNextTodo — 무엇이 확정을 막고 있나. 셋으로 갈린다: 결론이 모자라거나, 서명만
// 없거나, 다 찼거나.
templ reviewNextTodo(v ReviewView) {
	{{ s := v.Summary() }}
	if v.Activation != nil && v.ScopeLock == "" {
		@scopeActivateBox(v.Page, *v.Activation)
	}
	if v.NeedsBaseline() {
		@scopeBaselineBox(v.Page)
	} else if v.Unactivated() {
		@scopeUnactivatedBox(v.Page)
	} else if v.RulesetChanged {
		@rulesetRoundBox(v.Page)
	} else if v.Finalized {
		@newRoundBox(v.Page, tRoundReviewHead, tRoundReviewBody, ReviewNewPath, tRoundReviewDo)
	} else if s.Ready() {
		<div class="next done">
			<div class="next-icon">✓</div>
			<div>
				<strong>{ tNextReviewReady.In(v.Page.Lang) }</strong>
				<span>{ tNextReviewReadyBody.In(v.Page.Lang) }</span>
			</div>
			<a class="primary" href={ templ.SafeURL("#" + reviewEditAnchor) }>{ tNextReviewGo.In(v.Page.Lang) }</a>
		</div>
	} else {
		<div class="next">
			<div class="next-icon">!</div>
			<div>
				if s.Open == 0 {
					<strong>{ tNextReviewSignOnly.In(v.Page.Lang) }</strong>
					<span>{ tNextReviewSignBody.In(v.Page.Lang) }</span>
				} else if s.Signed {
					<strong>{ tNextReviewTodo.F(v.Page.Lang, s.Mandatory) }</strong>
					<span>{ tNextReviewTodoBody.F(v.Page.Lang, s.Open) }</span>
				} else {
					<strong>{ tNextReviewTodoSign.F(v.Page.Lang, s.Mandatory) }</strong>
					<span>{ tNextReviewTodoBody.F(v.Page.Lang, s.Open) }</span>
				}
			</div>
			<a class="primary" href={ templ.SafeURL("#" + reviewEditAnchor) }>{ tNextReviewGo.In(v.Page.Lang) }</a>
		</div>
	}
}

templ reviewNextMetrics(v ReviewView) {
	{{ s := v.Summary() }}
	<div class="metrics">
		<div class="metric">
			<b>{ strconv.Itoa(s.Policies) }</b>
			<span>{ tNextReviewMetricPolicies.In(v.Page.Lang) }</span>
		</div>
		<div class={ "metric", templ.KV("danger", s.Open > 0) }>
			<b>{ strconv.Itoa(s.Open) }</b>
			<span>{ tNextReviewMetricOpen.In(v.Page.Lang) }</span>
		</div>
		<div class="metric ok">
			<b>{ strconv.Itoa(s.Autopass) }</b>
			<span>{ tNextReviewMetricAutopass.In(v.Page.Lang) }</span>
		</div>
	</div>
}

// rulesetReport — 규칙 전환 회차로 열린 세션의 변환 보고서 요약. 규칙이 바뀌어 달라 보일 수 있다는 것을 먼저 적는다.
templ rulesetReport(v ReviewView) {
	if v.RulesetChange != nil {
		<section class="ruleset-change">
			<h3>{ tReportHead.In(v.Page.Lang) }</h3>
			<p class="hint">{ tReportNote.In(v.Page.Lang) }</p>
			<p class="hint">{ tReportFrom.In(v.Page.Lang) } <code>{ v.RulesetChange.FromRuleset }</code> · <code>{ v.RulesetChange.Report }</code></p>
			if changes := v.ReportChanges(); len(changes) > 0 {
				<ul>
					for _, c := range changes {
						<li><code>{ c.ID }</code> { changeLabel(v.Page.Lang, c.Change) }
							if len(c.NewInstallations) > 1 {
								· { tReportInstalls.F(v.Page.Lang, len(c.NewInstallations)) }
							}
						</li>
					}
				</ul>
			} else if v.Report == nil {
				<p class="hint">{ tReportMissing.In(v.Page.Lang) }</p>
			}
		</section>
	}
}

// scopeRoundNote — 이 세션을 연 정책 회차(기준선 · 활성화)와 그 근거. **운영자 진술로 연 회차는 그것이 상류 이력으로
// 증명한 것이 아니라고 화면에 남긴다**(영수증의 round.basis와 같은 값). 근거가 비어 있으면 운영자 진술로 읽는다.
templ scopeRoundNote(v ReviewView) {
	if v.ScopeChange != nil {
		<section class="ruleset-change">
			<h3>{ tScopeRoundHead.In(v.Page.Lang) }</h3>
			<p class="hint">
				{ tScopeRoundPolicy.In(v.Page.Lang) }
				if v.ScopeChange.FromPolicy != "" {
					<code>{ v.ScopeChange.FromPolicy }</code> →
				}
				<code>{ v.ScopeChange.ToPolicy }</code>
			</p>
			if v.ScopeChange.Basis == review.ScopeBasisUpstream {
				<p class="hint">{ tScopeBasisUpstream.In(v.Page.Lang) }</p>
			} else {
				<p class="hint"><strong>{ tScopeBasisOperator.In(v.Page.Lang) }</strong></p>
			}
		</section>
	}
}

// rulesetRoundBox — 다른 상류 규칙 판의 세션의 화면 위쪽. **할 일이 남았다는 상자다**(완료 모양이 아니다). 잠겨 있다고
// 알리고, 규칙 전환 회차를 여는 POST(요청 보호 · rev)를 둔다.
templ rulesetRoundBox(p Page) {
	<div class="next ruleset" role="status">
		<div class="next-icon">!</div>
		<div>
			<strong>{ tRulesetRoundHead.In(p.Lang) }</strong>
			<span>{ tRulesetRoundBody.In(p.Lang) }</span>
		</div>
		<form method="post" action={ templ.SafeURL(ReviewRulesetRoundPath) }>
			@csrfField(p)
			<button class="primary">{ tRulesetRoundDo.In(p.Lang) }</button>
		</form>
	</div>
}

// scopeBaselineBox — 정책 기록이 없는 옛 세션의 화면 위쪽. 할 일이 남았다는 상자다. 기준선 회차를 여는 POST(요청 보호 ·
// rev)를 둔다. 처리기가 pqcota 이력을 지금 정책으로 대조하고, 일치할 때만 연다. 운영자 확인 칸은 없다.
templ scopeBaselineBox(p Page) {
	<div class="next ruleset" role="status">
		<div class="next-icon">!</div>
		<div>
			<strong>{ tScopeBaselineHead.In(p.Lang) }</strong>
			<span>{ tScopeBaselineBody.In(p.Lang) }</span>
		</div>
		<form method="post" action={ templ.SafeURL(ReviewScopeBaselinePath) }>
			@csrfField(p)
			<button class="primary">{ tScopeBaselineDo.In(p.Lang) }</button>
		</form>
	</div>
}

// scopeActivateBox — 02에서 확정한 정책이 활성 정책과 다를 때 05 위쪽. **활성화에 필요한 순서를 단계로 보인다**: pqcota
// 재적재(운영자 명령) → pqcota 재적재 결과 대조(pqcaton이 한다) → 정책 활성화(확인 페이지를 거친다, 요청 보호 · rev). 번호는
// 의미 있는 <ol>이다. 운영자 진술 칸은 없다. 대조는 확인 페이지 요청과 실행 요청에서 한다.
templ scopeActivateBox(p Page, o ActivationOffer) {
	<div class="next ruleset activation" role="status" id={ scopeActivateAnchor }>
		<div class="next-icon">!</div>
		<div>
			<strong>{ tActivateHead.In(p.Lang) }</strong>
			<span>{ tActivateBody.In(p.Lang) }</span>
			<form method="post" action={ templ.SafeURL(ReviewScopeActivateConfirmPath) }>
				@csrfField(p)
				<ol class="activation-steps">
					<li>
						<strong>{ tActivateStep1.In(p.Lang) }</strong>
						<span>{ tActivateStep1Body.In(p.Lang) }</span>
						<code>{ o.IngestCommand() }</code>
						<span class="hint">{ tActivateStep1Hint.In(p.Lang) }</span>
					</li>
					<li>
						<strong>{ tActivateStep2.In(p.Lang) }</strong>
						<span>{ tActivateStep2Body.In(p.Lang) }</span>
					</li>
					<li>
						<strong>{ tActivateStep3.In(p.Lang) }</strong>
						<span>{ tActivateStep3Body.In(p.Lang) }</span>
						<button class="primary">{ tActivateNext.In(p.Lang) }</button>
					</li>
				</ol>
			</form>
		</div>
	</div>
}

// scopeUnactivatedBox — 활성화 기록 없이 정책이 바뀐 세션의 화면 위쪽. 회차 단추를 두지 않고 할 수 있는 두 가지만 적는다.
templ scopeUnactivatedBox(p Page) {
	<div class="next ruleset" role="status">
		<div class="next-icon">!</div>
		<div>
			<strong>{ tScopeUnactivatedHead.In(p.Lang) }</strong>
			<span>{ tScopeUnactivatedBody.In(p.Lang) }</span>
		</div>
	</div>
}

// newRoundBox — 확정된 세션의 화면 위쪽. 읽기 전용이라고 알리고, 새 회차를 여는 POST(요청 보호 · rev)를 둔다.
templ newRoundBox(p Page, head, body T, action string, do T) {
	<div class="next done" role="status">
		<div class="next-icon">✓</div>
		<div>
			<strong>{ head.In(p.Lang) }</strong>
			<span>{ body.In(p.Lang) }</span>
		</div>
		<form method="post" action={ templ.SafeURL(action) }>
			@csrfField(p)
			<button class="primary">{ do.In(p.Lang) }</button>
		</form>
	</div>
}
