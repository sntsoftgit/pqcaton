package ui

// recoveryPage — 복구 필요 상태의 화면(503). 남은 기록마다 어느 파일이 어떤 상태인지 보이고 진단 파일을 내려받게
// 한다. **푸는 버튼은 없다**: 어느 파일이 옳은지 제품이 정하지 않는다(M1). 전체 경로와 해시는 진단 파일에만 있다.
templ recoveryPage(v RecoveryView) {
	@nextShell(v.Page) {
		<div class="msg bad" role="alert">
			<strong>{ tRecoveryHead.In(v.Lang) }</strong>
			<p>{ tRecoveryLede.In(v.Lang) }</p>
		</div>
		<ol class="recovery-steps">
			<li>{ tRecoveryStep1.In(v.Lang) }</li>
			<li>{ tRecoveryStep2.In(v.Lang) }</li>
			<li>{ tRecoveryStep3.In(v.Lang) }</li>
			<li>{ tRecoveryStep4.In(v.Lang) }</li>
		</ol>
		if v.DiagHref != "" {
			<p><a href={ templ.SafeURL(v.DiagHref) } download>{ tRecoveryDiag.In(v.Lang) }</a></p>
		}
		if v.Ref != "" {
			<p>{ tRecoveryUnreadable.In(v.Lang) }</p>
			<p class="hint">{ tErrRef.In(v.Lang) }: <code>{ v.Ref }</code></p>
		}
		for _, rec := range v.Records {
			<section class="recovery-record">
				<h3>{ recordKindText(v.Lang, rec.Kind) } <span class="hint">{ rec.Started }</span></h3>
				<table>
					<thead>
						<tr>
							<th scope="col">{ tRecoveryColFile.In(v.Lang) }</th>
							<th scope="col">{ tRecoveryColChange.In(v.Lang) }</th>
							<th scope="col">{ tRecoveryColNow.In(v.Lang) }</th>
						</tr>
					</thead>
					<tbody>
						for _, it := range rec.Items {
							<tr class={ templ.KV("mismatch", it.Verdict == VerdictMismatch) }>
								<td><code>{ it.File }</code></td>
								<td>{ itemKindText(v.Lang, it.Kind) }</td>
								<td>{ verdictText(v.Lang, it.Verdict) }</td>
							</tr>
						}
					</tbody>
				</table>
			</section>
		}
	}
}
